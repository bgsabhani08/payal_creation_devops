{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "payal-creation",
          "appId": "1:700099258867:android:341e932da89090f71b8a86",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "payal-creation",
          "configurations": {
            "android": "1:700099258867:android:341e932da89090f71b8a86",
            "ios": "1:700099258867:ios:b50ad44b8cfa78fc1b8a86",
            "web": "1:700099258867:web:4a1745d8580f1eeb1b8a86"
          }
        }
      }
    }
  },
  "hosting": {
    "target": "website",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions"
    }
  ]
}
